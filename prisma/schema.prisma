// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model User {
  id String @id @default(cuid())

  name      String?
  phone     String      @unique()
  email     String?
  createdAt DateTime    @default(now()) @map("created_at")
  updatedAt DateTime    @updatedAt @map("updated_at")
  orders    Order[]
  PromoCode PromoCode[]

  @@map("user")
}

model Product {
  id          String      @id @default(cuid())
  image       String
  name        String
  slug        String      @unique
  description String
  active      Boolean
  price       Float
  servingSize Int
  weight      Int
  discount    Int         @default(0)
  filling     Json
  allergens   Json
  categoryId  String      @map("category_id")
  category    Category    @relation(fields: [categoryId], references: [id])
  createdAt   DateTime    @default(now()) @map("created_at")
  updatedAt   DateTime    @updatedAt @map("updated_at")
  orderItems  OrderItem[]

  @@map("product")
}

model Category {
  id        String    @id @default(cuid())
  name      String
  slug      String    @unique
  products  Product[]
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")

  @@map("category")
}

model Order {
  id        String         @id @default(cuid())
  items     OrderItem[]
  total     Int
  user      User?          @relation(fields: [userId], references: [id])
  userId    String?        @map("user_id")
  promocode String?
  details   Json
  status    OrderStatuses? @relation(fields: [statusId], references: [id])
  statusId  Int?           @default(1) @map("status_id")
  createdAt DateTime       @default(now()) @map("created_at")
  updatedAt DateTime       @updatedAt @map("updated_at")

  @@map("order")
}

model OrderItem {
  id       String @id @default(cuid())
  quantity Int
  price    Int

  order     Order?   @relation(fields: [orderId], references: [id])
  orderId   String?  @map("order_id")
  product   Product? @relation(fields: [productId], references: [id])
  productId String?  @map("product_id")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
}

model WorkingHours {
  id            String   @id @default(cuid())
  day           String   @unique
  deliveryStart String?  @map("delivery_start")
  deliveryEnd   String?  @map("delivery_end")
  takeawayStart String?  @map("takeaway_start")
  takeawayEnd   String?  @map("takeaway_end")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")
}

model PromoCode {
  id              String   @id @default(cuid())
  code            String   @unique
  active          Boolean  @default(false)
  discount        Int
  validFrom       DateTime
  validTo         DateTime
  activationLimit Int      @default(0)
  activationCount Int      @default(0)
  user            User?    @relation(fields: [userId], references: [id])
  userId          String?  @map("user_id")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")
}

model OrderStatuses {
  id     Int     @id @default(autoincrement())
  name   String  @unique
  desc   String
  orders Order[]
}
